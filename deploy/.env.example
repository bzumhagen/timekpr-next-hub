# Copy this file to deploy/.env and fill in real values before running
# `docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d`.
# Never commit deploy/.env itself.

POSTGRES_USER=timekpr_hub
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=timekpr_hub

# One timezone for the whole household.
HUB_TZ=America/Denver

# Which published hub image to run. Leave unset for `latest` (the newest
# non-prerelease); pin an exact release -- HUB_VERSION=0.1.0 -- so upgrading
# is something you choose rather than something a `docker compose pull`
# does to you. Ignored by `make deploy-up-source`, which builds from the
# checkout instead. Releases: https://github.com/bzumhagen/timekpr-next-hub/releases
#HUB_VERSION=0.1.0
