[Unit]
Description=timekpr-next-hub database migrations (alembic upgrade head)
Documentation=https://github.com/YOUR_ORG/timekpr-next-hub
After=network.target postgresql.service
Wants=postgresql.service
Before=timekpr-hub.service

[Service]
Type=oneshot
# RemainAfterExit means `systemctl start` after the first successful run is
# a no-op -- install.sh explicitly `restart`s this unit on every upgrade
# instead, so a migration always actually runs then.
RemainAfterExit=yes
User=timekpr-hub
Group=timekpr-hub
WorkingDirectory=/opt/timekpr-hub/src/hub
EnvironmentFile=/etc/timekpr-hub/hub.env

# Debian's postgresql.service is a oneshot meta-unit for pg_ctlcluster --
# ordering after it does not guarantee the cluster is actually accepting
# connections yet, so wait for that explicitly.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do pg_isready -q -h 127.0.0.1 -p 5432 && exit 0; sleep 1; done; exit 1'
ExecStart=/opt/timekpr-hub/venv/bin/alembic -c /opt/timekpr-hub/src/hub/alembic.ini upgrade head

TimeoutStartSec=600

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
