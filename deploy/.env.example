# Copy this file to deploy/.env and fill in real values before running
# `docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d`.
# Never commit deploy/.env itself.

POSTGRES_USER=timekpr_hub
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=timekpr_hub

# PLAN: "One timezone for the whole household."
HUB_TZ=America/Denver
